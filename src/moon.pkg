import {
  "moonbitlang/core/bench",
}

options(
  "cc-flags": "-O2",
  link: { "native": { "cc-link-flags": "-lz" } },
  "native-stub": [ "stub.c" ],
  targets: {
    "bench_native_test.mbt": [ "native" ],
    "lib_native.mbt": [ "native" ],
    "lib_nonnative.mbt": [ "not", "native" ],
    "row_eq_scalar.mbt": [ "not", "wasm" ],
    "row_eq_simd.mbt": [ "wasm" ],
  },
)
